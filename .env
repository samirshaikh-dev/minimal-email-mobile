# Base URL of the nodemailer-email-sender backend, inlined into the bundle by the Expo CLI.
# Keep the EXPO_PUBLIC_ prefix. Leave it empty to fall back to the platform default
# (http://10.0.2.2:4000 on Android emulators, http://localhost:4000 everywhere else).
#
# iOS simulator / web ....... http://localhost:4000
# Android emulator .......... http://10.0.2.2:4000
# Physical device (Wi-Fi) ... http://192.168.1.150:4000
# Production ................ https://your-service.onrender.com
EXPO_PUBLIC_API_URL=
